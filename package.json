{
  "name": "mola",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0",
    "test:browser": "uv run --with playwright python scripts/playtest.py",
    "android:sync": "npm run build && cap sync android",
    "test:economy": "node scripts/economy.mjs",
    "test:markets": "node scripts/menu-experiment.mjs",
    "test:market-ui": "uv run --with playwright python scripts/market-playtest.py",
    "test:visual": "uv run --with playwright python scripts/visual-playtest.py",
    "test:billing-server": "node --test server/billing/verify.node-test.mjs server/billing/diamonds.node-test.mjs server/billing/listen.node-test.mjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "7.2.0",
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "7.1.2",
    "@capacitor/core": "^7.6.9",
    "@fontsource/nunito": "^5.2.7",
    "three": "0.184.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@playwright/test": "^1.58.0",
    "@types/three": "0.183.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "license": "GPL-3.0-only"
}
